@page "/admin/users"
@attribute [Authorize(Roles="PlatformAdmin")]
@inject IServiceProvider Services
@inject IDbContextFactory<NetworkDbContext> DbFactory
@inject AuthenticationStateProvider Authentication
<h1>Local operator account administration</h1>
<p class="lede">Password-hashed local accounts, lockout and independent change-approval roles. No default passwords are shipped.</p>
@if(accounts is null){<div class="banner">Local account administration is unavailable in demo mode. Use the persona switcher instead.</div>}
else{
<div class="panel"><h2>Add an operator account</h2>
<div class="formgrid">
<label>Username<input @bind="username" autocomplete="off" /></label>
<label>Display name<input @bind="display" /></label>
<label>Initial password<input type="password" @bind="password" autocomplete="new-password" /></label>
<label>Role<select @bind="role">@foreach(var r in JcfRoles.All){<option value="@r">@r</option>}</select></label></div>
<p class="muted">Use a unique passphrase of at least 14 characters containing uppercase, lowercase, a number and a symbol. The password is not written to audit logs.</p>
<button @onclick="Create">Create account</button>
@if(message.Length>0){<p class="feedback" role="status">@message</p>}</div>
<div class="panel"><h2>Accounts</h2><table><thead><tr><th>Username</th><th>Display name</th><th>Role</th><th>Status</th><th>Created (UTC)</th><th>Actions</th></tr></thead><tbody>
@foreach(var user in users){<tr><td>@user.UserName</td><td>@user.DisplayName</td>
<td><select value="@user.Role" @onchange='e=>SetRole(user.Id,e.Value?.ToString()??"")'>@foreach(var r in JcfRoles.All){<option value="@r" selected="@(r==user.Role)">@r</option>}</select></td>
<td><span class="chip">@(user.IsDisabled?"Disabled":user.IsLockedOut?"Locked out":"Active")</span></td><td>@user.CreatedUtc.ToString("g")</td>
<td>@if(user.IsDisabled){<button class="smallbutton" @onclick='()=>Run(user.Id,a=>accounts.SetDisabledAsync(user.Id,false,a),"Account enabled.")'>Enable</button>}
else{<button class="smallbutton secondary" @onclick='()=>Run(user.Id,a=>accounts.SetDisabledAsync(user.Id,true,a),"Account disabled; sessions revoked within one minute.")'>Disable</button>}
@if(user.IsLockedOut){<button class="smallbutton" @onclick='()=>Run(user.Id,a=>accounts.UnlockAsync(user.Id,a),"Lockout cleared.")'>Unlock</button>}</td></tr>}
</tbody></table></div>
<div class="panel"><h2>Location access grants</h2>
<p class="muted">Users receive no fleet access automatically. Select the authorized location and role. Grants include child locations, not unrelated clusters.</p>
<div class="formgrid">
<label>User<select @bind="selectedUser"><option value="">Select user</option>@foreach(var u in users){<option value="@u.Id">@u.UserName</option>}</select></label>
<label>Location<select @bind="selectedLocation"><option value="">Select location</option>@foreach(var l in locations){<option value="@l.Id">@l.Name (@l.Type)</option>}</select></label>
<label>Site role<select @bind="siteRole">@foreach(var r in JcfRoles.All){<option value="@r">@r</option>}</select></label>
</div><button @onclick="Grant">Grant location permission</button>
<table><thead><tr><th>User</th><th>Location</th><th>Access</th><th>Action</th></tr></thead><tbody>
@foreach(var grant in siteGrants){<tr><td>@(users.FirstOrDefault(u=>u.Id==grant.UserId)?.UserName??grant.UserId.ToString())</td>
<td>@(locations.FirstOrDefault(l=>l.Id==grant.LocationId)?.Name??"Unknown")</td><td>@grant.Role</td>
<td><button class="smallbutton secondary" @onclick="()=>Revoke(grant.Id)">Revoke</button></td></tr>}
</tbody></table></div>}
@code {
 private OperatorAccountService? accounts;
 private List<OperatorAccountService.AccountView> users=new();
 private List<Location> locations=new();private List<SitePermission> siteGrants=new();
 private string selectedUser="",selectedLocation="",siteRole=JcfRoles.Viewer;
 private string username="",display="",password="",role=JcfRoles.Viewer,message="";
 protected override async Task OnInitializedAsync(){accounts=Services.GetService<OperatorAccountService>();if(accounts is not null)await Reload();}
 private async Task Reload(){users=await accounts!.ListAsync();
    await using var db=await DbFactory.CreateDbContextAsync();
    locations=await db.Locations.AsNoTracking().OrderBy(x=>x.Name).ToListAsync();
    siteGrants=await db.SitePermissions.AsNoTracking().OrderBy(x=>x.UserId).ToListAsync();
 }
 private async Task<string> Actor(){var current=(await Authentication.GetAuthenticationStateAsync()).User;JcfRoles.RequireAdmin(current);return current.Identity?.Name??"";}
 private async Task Create(){try{
    var actor=await Actor();
    await accounts!.CreateAsync(username,display,password,role,actor);
    username="";display="";message="Account created. The password is no longer held in this form.";await Reload();
 }catch(Exception ex){message=ex.Message;}finally{password="";}}
 private async Task Run(Guid id,Func<string,Task> action,string done){try{await action(await Actor());message=done;await Reload();}catch(Exception ex){message=ex.Message;}}
 private async Task Grant(){try{
    var actor=await Actor();
    if(!Guid.TryParse(selectedUser,out var uid)||!Guid.TryParse(selectedLocation,out var loc))throw new ArgumentException("Select a user and location.");
    if(!JcfRoles.All.Contains(siteRole,StringComparer.Ordinal))throw new ArgumentException("Unknown site role.");
    await using var db=await DbFactory.CreateDbContextAsync();
    if(!await db.Users.AnyAsync(u=>u.Id==uid)||!await db.Locations.AnyAsync(l=>l.Id==loc))throw new ArgumentException("Unknown user/location.");
    if(await db.SitePermissions.AnyAsync(p=>p.UserId==uid && p.LocationId==loc && p.Role==siteRole))throw new InvalidOperationException("Grant already exists.");
    var grant=new SitePermission{UserId=uid,LocationId=loc,Role=siteRole};db.SitePermissions.Add(grant);
    db.AuditEvents.Add(new AuditEvent{Actor=actor,Action="Grant site permission",Target=grant.Id.ToString(),Outcome=siteRole});
    await db.SaveChangesAsync();message="Site permission recorded.";await Reload();
 }catch(Exception ex){message=ex.Message;}}
 private async Task Revoke(Guid id){try{
    var actor=await Actor();
    await using var db=await DbFactory.CreateDbContextAsync();
    var grant=await db.SitePermissions.FindAsync([id]) ?? throw new KeyNotFoundException("Grant not found.");
    db.SitePermissions.Remove(grant);
    db.AuditEvents.Add(new AuditEvent{Actor=actor,Action="Revoke site permission",Target=id.ToString(),Outcome=grant.Role});
    await db.SaveChangesAsync();message="Site permission revoked.";await Reload();
 }catch(Exception ex){message=ex.Message;}}
 private async Task SetRole(Guid id,string newRole){try{await accounts!.SetRoleAsync(id,newRole,await Actor());message="Role updated to "+newRole+".";await Reload();}catch(Exception ex){message=ex.Message;await Reload();}}
}
